# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUNO_API_KEY: Sua chave de acesso para a API
# SUNO_API_KEY=
# SUNO_API_URL=
# MAKE_WEBHOOK_URI: Webhook do Make.com para receber os briefings (Use o prefixo VITE_ para funcionar no GitHub Pages)
VITE_MAKE_WEBHOOK_URI=
VITE_MAKE_API_KEY=
